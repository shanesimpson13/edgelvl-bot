# ── required (dry run works with just these) ────────────────────────────────
export EDGE_API_KEY="your_key_from_edgelvl.app/welcome"
export TELEGRAM_BOT_TOKEN="123456:ABC..."     # from @BotFather
export TELEGRAM_CHAT_ID="your_numeric_id"     # from @userinfobot

export DRY_RUN=1          # 1 = simulate (real quotes, no real money). Leave at 1.
export SIZE_SOL=0.05      # per trade

# ── only needed when you go live (Module 08) ────────────────────────────────
# export PRIVATE_KEY="trading_wallet_base58_key"     # use a wallet separate from your main one
# export RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
# export JUP_API_KEY="free_from_portal.jup.ag"

# ── Robinhood Chain, optional ───────────────────────────────────────────────
# The bot routes by the coin's address: an 0x address goes to rh.py and LI.FI,
# a base58 mint goes to jupiter.py. Leave these unset and it is Solana-only.
# export LIFI_API_KEY="free_from_portal.li.fi"
# export RH_INTEGRATOR="your_name_registered_at_portal.li.fi"   # who collects the fee
# export RH_WALLET_ID="privy_wallet_id"        # an EVM wallet — see privy.py
# export RH_ADDRESS="0x..."                    # that wallet's address
